# ============ Deployment ============
# cloud_multi_tenant | on_prem_isolated
DEPLOYMENT_MODE=cloud_multi_tenant
NODE_ENV=development
API_PORT=3000

# ============ Database ============
# Owner / migration role (superuser in dev container). Used ONLY by migrations & seed.
DATABASE_OWNER_URL=postgres://leadprocure_owner:owner_pass@127.0.0.1:55440/leadprocure
# Application role: NOSUPERUSER, NOBYPASSRLS, not table owner. Used by the running API (RLS enforced).
DATABASE_URL=postgres://app_user:app_pass@127.0.0.1:55440/leadprocure

# ============ Auth ============
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=1209600
REFRESH_COOKIE_NAME=lp_refresh
REFRESH_COOKIE_SECURE=false

# ============ Sealed-bid encryption ============
# 32-byte base64 master key that wraps per-event data keys (dev only; use KMS in prod).
BID_MASTER_KEY_B64=ZGV2X29ubHlfMzJfYnl0ZV9tYXN0ZXJfa2V5X18xMjM0NQ==

# ============ Award standstill ============
# DEFAULT hours between awarding a lot and being allowed to turn that award into a
# contract. During the pause the losing bidders — who are notified of the award — can still
# object, and the award can still be cancelled; afterwards it cannot.
#
# This is only the fallback: each buyer organization sets the window PER PROCUREMENT METHOD
# on its settings screen (award_standstill_policies), because an open tender needs a
# standstill and a three-quote RFQ does not. This number applies when a method has no
# policy of its own. 0 = no pause.
#
# A BUYER_ADMIN can close an active window early for an urgent purchase, with a written
# reason that lands in the audit log.
AWARD_STANDSTILL_HOURS=0

# ---- Which day is "the day" for a document (IANA zone name) ----
# `invoices.issued_at` stores an instant; naming a DAY from it needs a zone. The issue date
# of an invoice is frozen in `invoices.issue_date` at submission using this zone, and never
# recomputed afterwards — a document that already went out to e-qaimə keeps its date even if
# this setting changes later. Default: Asia/Baku, the market this product is built for.
# A name, not an offset (`Asia/Baku`, not `+04:00`): an unknown value refuses to boot rather
# than falling back to UTC and shifting a tax document by a day.
APP_TIMEZONE=Asia/Baku

# ============ Licensing ============
# Base64 Ed25519 public key embedded to verify signed license files (PASETO v4.public).
LICENSE_PUBLIC_KEY_B64=
# Path to the signed license file for on-prem deployments.
LICENSE_FILE=./infra/license/leadprocure.license
# Default edition when no license present (dev). One of: community | standard | enterprise
LICENSE_DEV_EDITION=enterprise

# ============ Object storage (MinIO / S3) ============
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=leadprocure
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ============ Antivirus (ClamAV) ============
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# ============ Web ============
VITE_API_BASE_URL=http://localhost:3000

# ---- CORS (comma-separated browser origins) ----
WEB_ORIGIN=http://localhost:5173

# ---- Email (SMTP; empty host = console provider) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Leadprocure <no-reply@leadprocure.local>

# ---- AI Orchestrator (optional; empty = in-process heuristic) ----
AI_ORCHESTRATOR_URL=

# Meta app secret authenticates WhatsApp POST callbacks (separate from the GET verify token).
# Empty = webhook POST disabled; configure only with the corresponding Meta app credentials.
WHATSAPP_APP_SECRET=
