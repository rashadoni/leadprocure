{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@leadprocure/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  },
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "testTimeout": 30000
}
