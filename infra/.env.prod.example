# Copy to .env.prod and fill in. NEVER commit .env.prod.
POSTGRES_DB=leadprocure
POSTGRES_OWNER_USER=leadprocure_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
# Use `openssl rand -hex 24` for both database passwords: they are embedded in URLs.
# Empty volumes provision app_user from this value; upgrades must keep the existing password.
APP_DB_PASSWORD=change_me_app

DEPLOYMENT_MODE=cloud_multi_tenant
# Operator-supplied issuer PUBLIC key (base64 PEM) and signed license directory.
# Never put the issuer private key in the deployment tree.
LICENSE_PUBLIC_KEY_B64=
LICENSE_DIR=./license
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
# 32-byte base64 key that wraps sealed-bid data keys (use a KMS in real prod)
BID_MASTER_KEY_B64=change_me_base64_32_bytes

# Public URLs (behind your TLS reverse proxy).
# WEB_ORIGIN accepts a comma-separated list of allowed browser origins (CORS);
# the FIRST one is where email links point.
WEB_ORIGIN=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# Object storage
S3_BUCKET=leadprocure
S3_ACCESS_KEY=change_me_minio_user
S3_SECRET_KEY=change_me_minio_pass

CLAMAV_ENABLED=true
# Public S3 address for BROWSER presigned URLs (SigV4 binds the host — must be reachable
# by users; the demo stand maps prod minio to host port 9002).
S3_PUBLIC_URL=http://localhost:9002

# Email (leave SMTP_HOST empty to log to console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Leadprocure <no-reply@leadprocure.local>

# Meta app signing secret for webhook POST authentication; empty disables callbacks.
WHATSAPP_APP_SECRET=
